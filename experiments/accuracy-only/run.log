    def __init__(self):
        super().__init__()
        self.solve = dspy.ReAct(
            dspy.Signature(
                "db_id: str, question: str, evidence: str -> sql: str",
                "Produce a read-only SQLite query answering the question using the actual database. "
                "Use query_database to inspect sqlite_master table definitions and relevant stored values before finalizing SQL. "
                "Never invent table names, columns, joins, or category encodings. Inspect schemas with SELECT name, sql FROM sqlite_master WHERE type = 'table' AND name NOT GLOB 'sqlite_*'. "
                "Treat evidence as guidance to intent and formulas, but verify literal values against data: evidence can have incorrect casing or an inaccurate boolean encoding. "
                "SQLite string equality is case-sensitive. For textual descriptions, look up the stored spelling using a targeted case-insensitive search and use the observed literal. "
                "For boolean/status fields, especially when evidence suggests an empty string for a negative state, inspect SELECT DISTINCT values of the field. Negative states may be stored as text 'false', numeric 0, NULL, or empty text; these are not interchangeable. Choose the observed encoding corresponding to the question's meaning. "
                "Execute a preview of the candidate query. A zero count is also a potentially empty result, not proof of correctness. If results are empty or zero, investigate suspect literals and joins before accepting them; do not simply remove requested conditions to get rows. An empty result may be legitimate after verification. "
                "Check projection as well as filtering: return requested columns in question order. For image bounding-box coordinate questions asking for the object class, return the image identifier followed by the class label, since coordinates are local to an image; join the object instance to its class lookup. Otherwise do not add unsolicited identifiers or diagnostic columns. "
                "Count distinct entity IDs when asked how many entities and joins can duplicate them. Keep aggregates over the requested population: an average of all ordered-book prices is over order lines, not distinct books or a filtered subset; an average of all works' dates is over works before joining chapters. Use AVG and real-valued arithmetic for percentage thresholds. "
                "Preserve correct joins and all requested conditions. Do not infer additional restrictions merely from phrasing. A truncated tool preview is not an error and must not cause a LIMIT in the final answer. "
                "Use bounded, targeted value probes rather than retrieving entire large tables. If a query fails, repair the cause using observed schema or error details and test again. "
                "Return only the final SQL statement in sql, with no Markdown, commentary, result rows, or tool parameters."
            ),
            tools=[query_database],
            max_iters=16,
        )

    def forward(self, **inputs):
        result = self.solve(
            db_id=inputs['db_id'],
            question=inputs['question'],
            evidence=inputs['evidence'],
        )
        sql = str(result.sql).strip()
        if sql.startswith('```'):
            lines = sql.splitlines()
            if lines and lines[0].startswith('```'):
                lines = lines[1:]
            if lines and lines[-1].strip() == '```':
                lines = lines[:-1]
            sql = '\n'.join(lines).strip()
        return dspy.Prediction(sql=sql)
