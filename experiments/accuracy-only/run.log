            'Use schema join keys and avoid joins that multiply the entities being counted. Respect COUNT versus SUM and explicit evidence about distinctness. For longest history use earliest non-null year, preserving ties via MIN when appropriate. '
            'Return only executable SQL in sql, without markdown.'
        ))
        self.revise = dspy.ChainOfThought(dspy.Signature(
            'question: str, evidence: str, schema_text: str, draft_sql: str, execution: str -> sql: str',
            'Audit the SQLite query semantically as well as syntactically. Successful execution does not prove correctness. '
            'Check projected column count, order, and meaning against question and evidence. Full names mapped to first_name, last_name must be two columns, not concatenation. '
            'Check all question restrictions, including occupational title or role filters: inspecting a facility does not by itself mean the employee has the requested occupation. '
            'Separate filter fields from output fields. For a Winter/Summer comparison within one year return season as the winning category, not the composite games_name used to identify the editions. '
            'Verify aggregate grain, joins, count versus sum, subtraction direction, and handling of extreme values. Do not introduce DISTINCT into counts without justification. '
            'An empty or truncated preview is not itself an error. Preserve a correct query. Fix genuine logical or execution errors. Return only executable SQL in sql, no markdown.'
        ))

    def forward(self, **inputs):
        db_id = inputs['db_id']
        question = inputs['question']
        evidence = inputs['evidence']

        def clean_sql(text: str) -> str:
            """Remove an optional markdown fence from generated SQL."""
            text = str(text).strip()
            if text.startswith('```'):
                lines = text.splitlines()
                text = '\n'.join(lines[1:])
                if text.rstrip().endswith('```'):
                    text = text.rstrip()[:-3]
            return text.strip()

        def execute(sql: str) -> str:
            """Obtain a bounded execution preview without propagating tool errors."""
            try:
                return str(query_database(db_id, sql, row_limit=20))
            except Exception as exc:
                return 'Execution error: ' + str(exc)

        definitions = []
        for page in range(20):
            try:
                result = query_database(
                    db_id,
                    "SELECT sql FROM sqlite_master WHERE type = 'table' AND name NOT GLOB 'sqlite_*' ORDER BY name LIMIT ? OFFSET ?",
                    parameters=[200, page * 200],
                    row_limit=200,
                )
                if result.get('error'):
                    definitions.append('Schema lookup error: ' + str(result['error']))
                    break
                rows = result.get('rows', [])
                definitions.extend(str(row[0]) for row in rows if row[0])
                if len(rows) < 200:
                    break
            except Exception as exc:
                definitions.append('Schema lookup error: ' + str(exc))
                break
        schema_text = '\n'.join(definitions)
        draft = self.generate(db_id=db_id, question=question, evidence=evidence, schema_text=schema_text)
        sql = clean_sql(draft.sql)
        preview = execute(sql)
        revised = self.revise(question=question, evidence=evidence, schema_text=schema_text, draft_sql=sql, execution=preview)
        final_sql = clean_sql(revised.sql)
        if final_sql != sql:
            preview = execute(final_sql)
            if 'Execution error:' in preview or ("'error':" in preview and "'error': None" not in preview):
                repaired = self.revise(question=question, evidence=evidence, schema_text=schema_text, draft_sql=final_sql, execution=preview)
                final_sql = clean_sql(repaired.sql)
        return dspy.Prediction(sql=final_sql)
