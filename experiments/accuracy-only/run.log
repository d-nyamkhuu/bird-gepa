    def __init__(self):
        super().__init__()
        self.solve = dspy.ReAct(
            dspy.Signature(
                "db_id: str, question: str, evidence: str -> sql: str",
                "Produce a read-only SQLite query answering the question using the actual database. "
                "Inspect schema using query_database: SELECT name, sql FROM sqlite_master WHERE type = 'table' AND name NOT GLOB 'sqlite_*'. Never invent columns, joins, or category encodings. Issue only one SQL statement per tool call. "
                "Use evidence to identify intended columns, conditions, and aggregation grain. Verify ambiguous textual literals with targeted case-insensitive probes and use observed stored spellings. Inspect distinct status values before interpreting negative boolean states: NULL, empty text, 'false', and 0 are not interchangeable. Language names may be stored as language codes; inspect the lookup rather than assuming the full name. "
                "Plan the output columns separately from filter and join columns. Evidence mentioning an identifier does not make that identifier a requested output. Return only the requested attributes, in question order, with the following semantic conventions: when asked for explanations or distinct object classes of images satisfying coordinate conditions, select DISTINCT class labels alone, not image IDs. Coordinates constrain object instances; join to the class lookup to obtain labels. Include image IDs only when explicitly requested. For a clinical observation's status, return its description, value, and units in that order, even when the description is also constrained in WHERE. For a person's full identity when names are split across columns, return first, middle, and last name in schema order, retaining NULL middle names; do not silently omit the middle name. Otherwise avoid unsolicited identifying or diagnostic columns. "
                "Respect aggregation grain. If evidence defines most as MAX of a stored games-played field, compare individual participation records with that maximum within the requested league; do not replace MAX with SUM across player records. For a singular who question selecting among players with maximum-game records and a college restriction, group qualifying records by the full name and rank by their count descending, selecting the top candidate. Derive the maximum from data, never assume a fixed games threshold. For ordinary maximum questions retain tied maxima unless a single winner or a further ranking is requested. Count distinct entity IDs when joins duplicate entities. Averages over all ordered-book prices use order lines; averages over all works' dates use works before joining chapters. Use real-valued arithmetic for percentages. "
                "Preserve every requested condition and correct join. Do not invent extra restrictions. Use bounded, targeted probes instead of retrieving entire large tables. Execute the actual final projected query before returning it, not just a diagnostic query with a different projection. Check the number and meaning of output columns as well as the filters. If final SQL changes after testing, test it again. Repair errors using observed schema and error details. Investigate zero counts or empty results for mistaken literals or joins without removing legitimate conditions; verified empty results are acceptable. Truncated previews are not errors and must not introduce a LIMIT into the final query. LIMIT is appropriate only for a requested top result. Return only the final SQL statement, without Markdown, commentary, result rows, or tool parameters."
            ),
            tools=[query_database],
            max_iters=18,
        )

    def forward(self, **inputs):
        result = self.solve(
            db_id=inputs['db_id'],
            question=inputs['question'],
            evidence=inputs['evidence'],
        )
        sql = str(result.sql).strip()
        if sql.startswith('```'):
            lines = sql.splitlines()
            if lines and lines[0].startswith('```'):
                lines = lines[1:]
            if lines and lines[-1].strip() == '```':
                lines = lines[:-1]
            sql = '\n'.join(lines).strip()
        return dspy.Prediction(sql=sql)
