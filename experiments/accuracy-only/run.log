    def __init__(self):
        super().__init__()
        self.generate = dspy.ChainOfThought(dspy.Signature(
            "db_id: str, question: str, evidence: str, schema_text: str -> sql: str",
            "Generate a read-only SQLite query answering the question using the supplied schema. "
            "Use only actual tables and columns, join through their keys, and return only requested columns. "
            "Follow evidence for literal values, column meanings, aggregates, and date boundaries. "
            "Preserve exact categorical strings even when they resemble numeric ranges. "
            "For a singular entity associated with the highest or lowest value, rank the underlying rows "
            "with ORDER BY the measure DESC or ASC LIMIT 1. Do not use equality to a MAX/MIN subquery "
            "for a singular winner, since ties can return additional entities. Evidence mentioning max "
            "identifies the ranking measure, not a requirement to return all ties. Return all ties only "
            "when explicitly requested. Do not introduce extra tie-breaking columns without instructions. "
            "When only the extremal numeric value is requested, use MAX/MIN. For ordinary lists do not "
            "add LIMIT. Use COUNT for counts and AVG for averages at the requested entity grain, avoiding "
            "unnecessary joins that multiply rows. Output only SQL in the sql field, without fences."
        ))
        self.revise = dspy.ChainOfThought(dspy.Signature(
            "question: str, evidence: str, schema_text: str, draft_sql: str, execution: str -> sql: str",
            "Review the SQLite query for semantic correctness and execution errors. Preserve it when "
            "correct. Return only SQL in the sql field without markdown. Check selected columns, key joins, "
            "literal filters, aggregation grain, and requested cardinality. In particular, a singular "
            "entity associated with the highest/lowest measure calls for ORDER BY measure DESC/ASC LIMIT 1, "
            "not equality to MAX/MIN returning every tied entity. A max/min hint in evidence does not "
            "override singular winner semantics. Use all-ties logic only if requested; do not invent "
            "secondary sorting criteria. Empty results and truncated previews are not themselves errors; "
            "never limit an ordinary list just to match the preview. Preserve exact evidence filters."
        ))

    def forward(self, **inputs):
        db_id = inputs['db_id']
        question = inputs['question']
        evidence = inputs['evidence']

        def clean_sql(value: str) -> str:
            """Remove optional markdown wrappers from generated SQL."""
            text = str(value).strip()
            if text.startswith('```'):
                text = text.split('\n', 1)[-1]
                text = text.rsplit('```', 1)[0].strip()
            return text

        definitions = []
        for page in range(10):
            result = query_database(
                db_id,
                "SELECT sql FROM sqlite_master WHERE type = 'table' AND name NOT GLOB 'sqlite_*' ORDER BY name LIMIT ? OFFSET ?",
                parameters=[200, page * 200],
                row_limit=200,
            )
            if result.get('error'):
                definitions.append('Schema inspection error: ' + str(result['error']))
                break
            rows = result.get('rows', [])
            definitions.extend(str(row[0]) for row in rows if row[0])
            if len(rows) < 200:
                break
        schema_text = '\n'.join(definitions)
        sql = clean_sql(self.generate(
            db_id=db_id, question=question, evidence=evidence, schema_text=schema_text
        ).sql)
        for attempt in range(2):
            execution = query_database(db_id, sql, row_limit=20)
            if attempt == 1 and not execution.get('error'):
                break
            revised = clean_sql(self.revise(
                question=question, evidence=evidence, schema_text=schema_text,
                draft_sql=sql, execution=str(execution)
            ).sql)
            if revised == sql:
                break
            sql = revised
        return dspy.Prediction(sql=sql)
