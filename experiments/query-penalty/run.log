    def __init__(self):
        super().__init__()
        self.generate = dspy.ReAct(
            dspy.Signature(
                'db_id: str, question: str, evidence: str, schema_text: str -> sql: str',
                'Produce a read-only SQLite query answering the question using the supplied schema. Return only SQL in the sql field, without markdown. '
                'The schema has already been fetched; do not fetch it again. Use query_database only for targeted data-value checks when genuinely needed, not routine execution of a finished query. '
                'Project exactly the requested attributes. When a person name is stored as first and last name columns, select both separately in that order; do not concatenate unless explicitly requested. Do not add IDs or metrics not requested. '
                'Use evidence to identify columns, relationships, aggregation definitions and explicit comparison predicates. Honor explicit join mappings even when their names differ from the natural-language concept. Explicit numeric bounds, dates, and quantities in the question override conflicting numbers in evidence. '
                'Preserve direct column comparisons specified by evidence: translate column > numeric_threshold directly, without adding CAST, arithmetic coercion, REPLACE, currency stripping or other normalization unless the question or evidence explicitly requests that transformation. SQLite native comparison and affinity semantics are part of the query semantics, even for a text column representing a monetary amount. A speculative CAST to REAL can turn formatted text into zero or a partial number and silently change the answer. Do not infer a need to cast just from a column type or a currency unit in the question. '
                'Evidence text values can be abbreviated or typographically different from stored values. For categorical filters whose wording may be shorthand (such as a risk level), inspect DISTINCT values of the relevant column and use the actual stored label. For quoted prose with Unicode punctuation, verify the stored text using a distinctive prefix LIKE search; typographic ellipses and three periods may differ. Do not blindly trust an evidence literal or change the intended concept. Prefer one small targeted lookup over executing an empty final query repeatedly. '
                'Choose the aggregation grain from the requested output entity: when ranking named businesses by number of violations, group by business name so multiple location IDs with the same name contribute together. For the single most frequent group use ORDER BY COUNT(*) DESC LIMIT 1 unless ties are requested. In contrast, for the largest or longest value of a stored measurement, use equality to a MAX subquery to preserve all tied records. For youngest people, maximize birthdate within the requested eligible population. '
                'Count distinct entity IDs when joins multiply entities that should each count once. Use only necessary joins and respect inclusive range endpoints. Quote reserved identifiers and identifiers containing spaces. Do not use a preview row limit as an answer limit. Before finishing, check the projection shape, evidence mappings, literal values, numeric bounds, join multiplicity, grouping grain and whether any unrequested coercion has altered a predicate. Avoid redundant tool calls; no final execution is required when SQL is clear.'
            ),
            tools=[query_database],
            max_iters=5,
        )

    def forward(self, **inputs):
        db_id = inputs['db_id']
        definitions = []
        for page in range(5):
            result = query_database(
                db_id,
                "SELECT name, sql FROM sqlite_master WHERE type = 'table' AND name NOT GLOB 'sqlite_*' ORDER BY name LIMIT ? OFFSET ?",
                parameters=[200, page * 200],
                row_limit=200,
            )
            if result.get('error'):
                definitions.append('Schema retrieval error: ' + str(result['error']))
                break
            rows = result.get('rows', [])
            definitions.extend(str(row[1]) for row in rows if row[1])
            if len(rows) < 200:
                break
        out = self.generate(
            db_id=db_id,
            question=inputs['question'],
            evidence=inputs['evidence'],
            schema_text='\n'.join(definitions),
        )
        sql = str(out.sql).strip()
        if sql.startswith('```'):
            lines = sql.splitlines()
            sql = '\n'.join(lines[1:-1] if lines[-1].strip() == '```' else lines[1:]).strip()
        return dspy.Prediction(sql=sql)
