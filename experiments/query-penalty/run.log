    def __init__(self):
        super().__init__()
        self.generate = dspy.ChainOfThought(dspy.Signature(
            "db_id: str, question: str, evidence: str, schema_text: str -> sql: str",
            "Generate one read-only SQLite query answering the question using the supplied database schema. "
            "Use actual table and column names and join through the appropriate keys, including bridge tables when necessary. "
            "Evidence defines the intended columns, literal values, filters, and calculations; preserve these exactly. "
            "Textual categories containing commas or plus signs are exact strings, not numeric ranges. "
            "Honor explicit inclusive date boundaries. Use COUNT for how many records and AVG for average values; "
            "avoid joins that multiply the entities being counted or averaged. Select only requested output columns. "
            "For a singular entity associated with the highest or lowest value, order by that value DESC or ASC and "
            "LIMIT 1. Do not use equality to a MAX/MIN subquery to return every tied entity unless the question "
            "explicitly requests all ties. Evidence mentioning max explains the ranking metric, not necessarily "
            "a request for all tied rows. Do not invent tie-breakers. For ordinary lists return the complete list "
            "without an arbitrary LIMIT. Use DISTINCT when the requested list is of unique names, but not to "
            "change aggregate semantics. Check the query's identifiers, joins, predicates, and requested cardinality "
            "against the schema before answering. Output only SQL in the sql field, without markdown or commentary."
        ))

    def forward(self, **inputs):
        db_id = inputs['db_id']
        schema_parts = []
        for page in range(5):
            result = query_database(
                db_id,
                "SELECT name, sql FROM sqlite_master WHERE type IN ('table', 'view') "
                "AND name NOT GLOB 'sqlite_*' ORDER BY name LIMIT ? OFFSET ?",
                parameters=[200, page * 200],
                row_limit=200,
            )
            if result.get('error'):
                schema_parts.append('Schema retrieval error: ' + str(result['error']))
                break
            rows = result.get('rows', [])
            schema_parts.extend(str(row[1]) for row in rows if row[1])
            if len(rows) < 200:
                break
        generated = self.generate(
            db_id=db_id,
            question=inputs['question'],
            evidence=inputs['evidence'],
            schema_text='\n'.join(schema_parts),
        )
        sql = str(generated.sql).strip()
        if sql.startswith('```'):
            lines = sql.splitlines()
            lines = lines[1:]
            if lines and lines[-1].strip() == '```':
                lines = lines[:-1]
            sql = '\n'.join(lines).strip()
        return dspy.Prediction(sql=sql)
