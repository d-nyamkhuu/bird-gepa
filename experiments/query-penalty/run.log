    def __init__(self):
        super().__init__()
        self.generate = dspy.ChainOfThought(dspy.Signature(
            "db_id: str, question: str, evidence: str, schema_text: str -> sql: str",
            "Write one read-only SQLite query answering the question using the supplied schema. Evidence gives authoritative column mappings, predicates, and computations; combine it with all question restrictions. Use only existing tables and columns and join on appropriate keys. Determine the complete output shape before writing SQL. For a physical or clinical measurement such as height or weight, select the measurement VALUE followed by its UNITS when both are stored: units are part of the requested measurement, not an unrelated extra column. Do not concatenate them. When full name maps to first_name and last_name, select those separately in that order unless concatenation is explicitly requested. Role nouns such as sanitarians require the corresponding employee title filter. For a comparison of Winter and Summer Olympics within a year, display season rather than the composite games_name, with any requested numeric difference separately. Distinguish filtering attributes from requested display attributes. Preserve aggregation grain carefully: do not automatically add DISTINCT to a count of entities after a join. For institutional graduation statistics, count qualifying joined graduation records using COUNT of the institution name (chronname when present); multiple qualifying demographic/cohort records for one institution still contribute, unless unique institutions are explicitly requested. Conversely, separate/distinct users requires COUNT(DISTINCT user identifier), and counting people by nationality and gender should count people without multiplying participation records. Apply evidence predicates directly, preserving SQLite column affinity: do not add CAST to numeric-looking columns merely because their declared type is text, and do not replace a supplied comparison with a casted comparison. Use the actual values asked in the question when evidence only illustrates a mapping with other years or examples. Respect specified SUM, COUNT denominators, MIN, MAX, and subtraction direction; use real division for ratios. Extremum subqueries preserve ties. Use case-insensitive category matching when capitalization is immaterial, but preserve explicit coded literals. Return only SQL without markdown or commentary."
        ))
        self.review = dspy.Predict(dspy.Signature(
            "question: str, evidence: str, schema_text: str, draft_sql: str -> sql: str",
            "Review the SQLite query and return corrected SQL, or unchanged SQL if correct. Check output shape, joins, aggregation grain, and all restrictions against the schema and evidence. A requested physical/clinical observation includes both VALUE and UNITS when available, in that order; do not drop units under a rule against extra columns. Full names mapped to two columns should remain two separate columns. Role nouns require title filters. Olympic season comparisons should display season, not a composite games label. Do not add unrelated output columns. Do not silently introduce DISTINCT into ordinary joined-record counts: institutional graduation statistics count matching graduation rows via COUNT of the institution name, not distinct institution IDs, unless uniqueness is explicitly requested. Retain distinct-person counting where the question asks for separate users or a population of people and related rows could multiply people. Preserve evidence-specified predicates as written in meaning and SQLite affinity; remove gratuitous CAST operations that change comparison semantics, including numeric casts of text-affinity graduation fields. Respect specified aggregate functions, denominators, subtraction direction and question literals. Do not change correct SQL unnecessarily. Return only the final SQL."
        ))

    def forward(self, **inputs):
        db_id = inputs['db_id']
        definitions = []
        for page in range(5):
            result = query_database(
                db_id,
                "SELECT sql FROM sqlite_master WHERE type IN ('table', 'view') AND name NOT GLOB 'sqlite_*' AND sql IS NOT NULL ORDER BY name LIMIT ? OFFSET ?",
                parameters=[200, page * 200],
                row_limit=200,
            )
            if result.get('error'):
                definitions.append('Schema retrieval error: ' + str(result['error']))
                break
            rows = result.get('rows', [])
            definitions.extend(str(row[0]) for row in rows if row[0])
            if len(rows) < 200:
                break
        schema_text = '\n'.join(definitions)
        draft = self.generate(
            db_id=db_id,
            question=inputs['question'],
            evidence=inputs['evidence'],
            schema_text=schema_text,
        )
        reviewed = self.review(
            question=inputs['question'],
            evidence=inputs['evidence'],
            schema_text=schema_text,
            draft_sql=str(draft.sql),
        )
        sql = str(reviewed.sql).strip()
        if sql.startswith('```'):
            lines = sql.splitlines()
            sql = '\n'.join(lines[1:-1] if lines[-1].strip() == '```' else lines[1:]).strip()
        return dspy.Prediction(sql=sql)
