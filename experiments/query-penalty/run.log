            evidence=inputs['evidence'],
            schema_text='\n'.join(definitions),
        )
        sql = str(out.sql).strip()
        if sql.startswith('```'):
            lines = sql.splitlines()
            sql = '\n'.join(lines[1:-1] if lines[-1].strip() == '```' else lines[1:]).strip()
        return dspy.Prediction(sql=sql)
