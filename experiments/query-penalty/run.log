    def __init__(self):
        super().__init__()
        self.generate = dspy.ChainOfThought(dspy.Signature(
            "db_id: str, question: str, evidence: str, schema_text: str -> sql: str",
            "Write one read-only SQLite query answering the question using the supplied database schema. "
            "Evidence gives authoritative mappings for columns, literal filters, and computations. Use only existing tables and columns and join on appropriate keys. "
            "Carefully determine the exact output columns before writing SQL. When full name is mapped to first_name and last_name, select those as two separate columns in that order; do not concatenate unless explicitly requested. "
            "Include every restriction in the question, including occupational roles: asking for sanitarians requires the employee title to be Sanitarian, not merely that the employee performed an inspection. Evidence supplements rather than replaces question constraints. "
            "Distinguish filter identifiers from requested output attributes. When comparing Winter versus Summer Olympics within a year and asking which game has more competitors, output the season attribute, not the year-prefixed games_name; games_name can still be used to filter editions. More generally return the category being compared rather than a composite label when the schema provides that category. "
            "Preserve the requested counting grain: COUNT of a specified identifier is not automatically COUNT DISTINCT. Avoid joins that multiply counted entities. Use DISTINCT for lists of entities when repeated related records would duplicate them. "
            "Use the specified SUM, MIN, MAX, or subtraction and its direction. For earliest or latest entities, an extremum subquery preserves ties. "
            "Use case-insensitive comparison for natural-language category names when capitalization is immaterial, but preserve explicit coded literals and evidence mappings. "
            "Return only SQL in the sql field, without markdown or commentary."
        ))
        self.review = dspy.Predict(dspy.Signature(
            "question: str, evidence: str, schema_text: str, draft_sql: str -> sql: str",
            "Statically review the SQLite query and return the corrected query, or unchanged SQL if correct. "
            "Check exact output shape and meaning, joins, aggregation grain, and all question restrictions. "
            "If evidence maps a full name to two name columns, return both columns separately, not a concatenated string. "
            "Role nouns such as sanitarians require the corresponding title filter even when every joined person performed the relevant activity. "
            "For a within-year comparison of Winter and Summer Olympics, the winning label should be season, not the composite games_name; retain the required numeric difference as a separate column. "
            "Do not confuse columns used for filtering with columns requested for display. Do not add unrequested output columns. "
            "Respect evidence-specified aggregate functions and subtraction direction. Do not change correct SQL unnecessarily. Return only the final SQL in the sql field."
        ))

    def forward(self, **inputs):
        db_id = inputs['db_id']
        definitions = []
        for page in range(5):
            result = query_database(
                db_id,
                "SELECT sql FROM sqlite_master WHERE type IN ('table', 'view') AND name NOT GLOB 'sqlite_*' AND sql IS NOT NULL ORDER BY name LIMIT ? OFFSET ?",
                parameters=[200, page * 200],
                row_limit=200,
            )
            if result.get('error'):
                definitions.append('Schema retrieval error: ' + str(result['error']))
                break
            rows = result.get('rows', [])
            definitions.extend(str(row[0]) for row in rows if row[0])
            if len(rows) < 200:
                break
        schema_text = '\n'.join(definitions)
        draft = self.generate(
            db_id=db_id,
            question=inputs['question'],
            evidence=inputs['evidence'],
            schema_text=schema_text,
        )
        reviewed = self.review(
            question=inputs['question'],
            evidence=inputs['evidence'],
            schema_text=schema_text,
            draft_sql=str(draft.sql),
        )
        sql = str(reviewed.sql).strip()
        if sql.startswith('```'):
            lines = sql.splitlines()
            sql = '\n'.join(lines[1:-1] if lines[-1].strip() == '```' else lines[1:]).strip()
        return dspy.Prediction(sql=sql)
